# Server configuration
PORT=3101
JWT_SECRET=replace-with-a-long-random-secret

# Preferred connection style: a single PostgreSQL URL.
# Local example: postgres://postgres:postgres@localhost:5432/gamelog_capstone
DATABASE_URL=

# Alternative: individual variables, used only when DATABASE_URL is empty.
PGDATABASE=
PGHOST=
PGPASSWORD=
PGPORT=5432
PGUSER=
